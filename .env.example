# TaskFlow instance URL (scheme included: http for tests, https for production)
TASKFLOW_URL=http://localhost:3100
# Base path of the deployment (NEXT_BASE_PATH). Empty for a root deploy.
TASKFLOW_BASE_PATH=/taskflow
# Full override of the API base (wins over URL+BASE_PATH), e.g. https://host/taskflow/api
#TASKFLOW_API_BASE=
# Personal API token: TaskFlow -> Settings -> API Tokens (shown once at creation)
TASKFLOW_API_TOKEN=
# Request timeout, seconds
TASKFLOW_TIMEOUT=30
# Cap for list tools when the caller gives no limit (server-side total is reported)
TASKFLOW_MAX_LIST_ITEMS=200
# Cap for attachment download size (base64 in tool output)
TASKFLOW_MAX_DOWNLOAD_MB=5
# Usage rules the agent must read via the `howto` tool before working.
# Inline Markdown text, e.g. "Всегда спрашивай разрешения заводить задачу"
#TASKFLOW_HOWTO=
# …or a path to a Markdown file with the rules (wins over TASKFLOW_HOWTO)
#TASKFLOW_HOWTO_FILE=
# --- Network mode (TASKFLOW_MCP_TRANSPORT=streamable-http or both) ---
# Transport: "stdio" (default, local MCP client only), "streamable-http"
# (TCP only, for remote clients) or "both" (stdio + TCP in one process)
#TASKFLOW_MCP_TRANSPORT=stdio
# Bind address/port and URL path of the MCP endpoint
#TASKFLOW_MCP_HOST=127.0.0.1
#TASKFLOW_MCP_PORT=8000
#TASKFLOW_MCP_PATH=/mcp
# Shared secret for the endpoint; remote clients send it as
# "Authorization: Bearer <value>". Empty = open endpoint (fine on loopback)
#TASKFLOW_MCP_AUTH_TOKEN=
# Stateless HTTP sessions (per-request, no Mcp-Session-Id)
#TASKFLOW_MCP_STATELESS=
